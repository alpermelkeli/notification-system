# Copy to .env to override defaults. docker-compose reads it automatically; for local runs
# (`make run-*`) export the variables in your shell. Unset variables use the defaults shown.

# ---- logging & process
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json                # json | text
# INSTANCE_ID=                 # default: hostname (the container id under Docker)
SHUTDOWN_TIMEOUT=15s           # graceful shutdown deadline; keep below compose stop_grace_period (20s)

# ---- listen addresses
HTTP_ADDR=:8080                # api: public HTTP API
ADMIN_ADDR=:9090               # dispatcher / worker: /healthz, /readyz, /metrics

# ---- dependencies (docker-compose sets the in-network values itself)
DATABASE_URL=postgres://notifier:notifier@localhost:5432/notifier?sslmode=disable
KAFKA_BROKERS=localhost:9092   # comma-separated
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ---- mock provider (cmd/mockprovider)
MOCK_ADDR=:8081
MOCK_LATENCY=50ms
MOCK_LATENCY_JITTER=100ms
MOCK_FAILURE_RATE=0            # probability of HTTP 500
MOCK_RATE_LIMIT_RATE=0         # probability of HTTP 429 + Retry-After
MOCK_RETRY_AFTER=1s
