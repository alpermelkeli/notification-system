# Copy to .env to override defaults. docker-compose reads it automatically; for local runs
# (`make run-*`) export the variables in your shell. Unset variables use the defaults shown.

# ---- logging & process
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json                # json | text
# INSTANCE_ID=                 # default: hostname (the container id under Docker)
SHUTDOWN_TIMEOUT=15s           # graceful shutdown deadline; keep below compose stop_grace_period (20s)

# ---- listen addresses
HTTP_ADDR=:8080                # api: public HTTP API
ADMIN_ADDR=:9090               # dispatcher / worker: /healthz, /readyz, /metrics

# ---- dependencies (docker-compose sets the in-network values itself)
DATABASE_URL=postgres://notifier:notifier@localhost:5432/notifier?sslmode=disable
KAFKA_BROKERS=localhost:9092   # comma-separated
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ---- data lifecycle (ADR-0004, ADR-0008)
IDEMPOTENCY_TTL=72h            # how long an Idempotency-Key is remembered (<= RETENTION_DAYS)
RETENTION_DAYS=30              # daily partitions older than this are dropped
PARTITION_PREMAKE_DAYS=7       # partitions created ahead of today
MAINTENANCE_INTERVAL=1h        # dispatcher: partition + key maintenance cadence
MAX_SCHEDULE_AHEAD=168h        # api: latest allowed scheduledAt (at least 1 day < RETENTION_DAYS)
REQUEST_TIMEOUT=10s            # api: per-request deadline (503 timeout when exceeded)

# ---- dispatcher (ADR-0003)
DISPATCH_BATCH_SIZE=500        # due rows published per transaction
DISPATCH_POLL_INTERVAL=500ms   # fallback poll for scheduled / retrying rows (NOTIFY wakes it for new ones)
REAPER_INTERVAL=30s            # expired leases + queued rows consumed without a claim
REAPER_GRACE=1m                # queued rows younger than this are never requeued
REAPER_STUCK_AFTER=24h         # age fallback for queued rows the offset rule cannot judge

# ---- worker (ADR-0002, ADR-0005, ADR-0006)
WORKER_CHANNELS=sms,email,push # channels this process delivers (one consumer group member each)
WORKER_CONCURRENCY=20          # sends in flight per channel
PROVIDER_URL=http://localhost:8081/  # e.g. https://webhook.site/<uuid>; compose defaults to the mock provider
PROVIDER_TIMEOUT=10s
LEASE_DURATION=30s             # claim lifetime; >= PROVIDER_TIMEOUT + 5s
RATE_LIMIT_SMS=100             # msg/s per channel across all workers (FR-2.2)
RATE_LIMIT_EMAIL=100
RATE_LIMIT_PUSH=100
RATE_LIMIT_BURST=1             # >1 lets one second exceed the limit by up to burst-1 after an idle period
RETRY_BASE_DELAY=5s            # backoff ceiling of the first retry; doubles per attempt, equal jitter
RETRY_MAX_DELAY=5m             # cap of the backoff ceiling
MAX_ATTEMPTS=5                 # attempt budget (also read by the dispatcher's reaper)
SCHEDULER_AGING_RATE=2         # priority points gained per second waited (capped per priority)
SCHEDULER_MIN_SHARE=10         # every Nth send goes to normal/low under a high flood (0 = off)

# ---- mock provider (cmd/mockprovider)
MOCK_ADDR=:8081
MOCK_LATENCY=50ms
MOCK_LATENCY_JITTER=100ms
MOCK_FAILURE_RATE=0            # probability of HTTP 500
MOCK_RATE_LIMIT_RATE=0         # probability of HTTP 429 + Retry-After
MOCK_RETRY_AFTER=1s
